{
  "name": "@propella/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "seed": "tsx src/seeds/run-seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node scripts/smoke.cjs && node scripts/smoke-admin.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "admin:grant": "node scripts/make-admin.cjs",
    "admin:list": "node scripts/make-admin.cjs --list",
    "test:admin": "node scripts/smoke-admin.cjs",
    "push:keys": "tsx scripts/generate-vapid-keys.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@propella/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "resend": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@propella/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.0",
    "tsx": "^4.16.2",
    "typescript": "^5"
  }
}
