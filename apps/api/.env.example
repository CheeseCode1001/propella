NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────────────────────
# DATABASE_URL — pooled connection, used by the running app.
# DIRECT_URL   — direct connection, used only by `prisma migrate`.
#                Leave blank to reuse DATABASE_URL.
#
# Supabase → Project Settings ▸ Database ▸ Connection string
#   DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Neon → Dashboard ▸ Connection details
#   DATABASE_URL=postgresql://<user>:<pw>@ep-xxx-pooler.<region>.aws.neon.tech/propella?sslmode=require
#   DIRECT_URL=postgresql://<user>:<pw>@ep-xxx.<region>.aws.neon.tech/propella?sslmode=require
DATABASE_URL=
DIRECT_URL=

# ─── Auth ────────────────────────────────────────────────────────────
# Long random strings — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Session length. ACCESS_TOKEN_TTL is how long a session lasts before it is
# silently renewed; REFRESH_TOKEN_TTL is how long that renewal stays possible.
ACCESS_TOKEN_TTL=1d
REFRESH_TOKEN_TTL=30d

# ─── AI (Google Gemini) ──────────────────────────────────────────────
# Required for quiz generation, mock exams and the AI assistant.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned to the -latest aliases so a model retirement does not break the app.
# On a paid key, gemini-pro-latest gives better questions; the free tier has no
# pro quota, so flash is the working default.
GEMINI_QUIZ_MODEL=gemini-flash-latest
GEMINI_CHAT_MODEL=gemini-flash-latest

# ─── Email ───────────────────────────────────────────────────────────
# Resend API key for transactional email. Blank disables sending.
RESEND_API_KEY=

# ─── Frontend ────────────────────────────────────────────────────────
# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Admin dashboard origin for CORS
ADMIN_URL=http://localhost:3001

# ─── Super admin ─────────────────────────────────────────────────────
# Seeded by `pnpm seed`. In development a default is used when these are
# blank (admin@propella.local / ChangeMe!2026); in production the seed is
# skipped entirely unless both are set.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional: cookie domain for cross-subdomain cookies (e.g. .propella.com)
COOKIE_DOMAIN=

# ─── Web push ────────────────────────────────────────────────────────
# Generate a pair with: pnpm --filter @propella/api push:keys
# Blank disables push delivery; the app still records in-app notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@propella.app
